<%# The official app lives on Zapstore, Obtainium and GitHub releases. An instance
    that publishes its own APK (ANDROID_DOWNLOAD_URL) gets that link as well. %>
<% links = ApplicationHelper::ANDROID_APP_LINKS.map { |key, href| [t(".#{key}"), href] } %>
<% own_apk = safe_external_url(ENV["ANDROID_DOWNLOAD_URL"]) %>
<% links << [t(".download"), own_apk] if own_apk && ApplicationHelper::ANDROID_APP_LINKS.values.exclude?(own_apk) %>
<div id="android-app" class="border-t border-gray-200 dark:border-gray-700 pt-6 mt-6">
  <h2 class="text-lg font-medium text-gray-900 dark:text-white"><%= t(".title") %></h2>
  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t(".intro") %></p>
  <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t(".web_app") %></p>
  <div class="mt-3 flex flex-wrap gap-2">
    <% links.each do |label, href| %>
      <%= link_to label, href, rel: "noopener noreferrer", target: "_blank",
          class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700" %>
    <% end %>
  </div>
</div>
