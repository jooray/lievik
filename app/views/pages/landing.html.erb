                <path d="M12 22s8-3.8 8-10V5l-8-3-8 3v7c0 6.2 8 10 8 10Z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
              <%= t(".hero.quiet_note") %>
            </p>
          </div>

          <div
            class="desk"
            aria-label="<%= t(".desk.aria_label") %>"
          >
            <div class="workspace">
              <div class="workspace-top">
                <span class="workspace-label"><%= t(".desk.label") %></span
                ><span class="identity"
                  ><span class="avatar">M</span> npub1mara...</span
                >
              </div>
              <div class="workspace-body">
                <div class="source-card">
                  <p class="card-kicker"><%= t(".desk.source_kicker") %></p>
                  <div class="note-head">
                    <span class="note-avatar" aria-hidden="true"></span>
                    <div>
                      <p class="note-byline"><%= t(".desk.note_byline") %></p>
                      <p class="note-meta"><%= t(".desk.note_meta") %></p>
                    </div>
                  </div>
                  <p class="note-copy">
                    <%= t(".desk.note_copy") %>
                  </p>
                  <span class="note-link"><%= t(".desk.note_link") %></span>
                </div>
                <div class="audience-card">
                  <p class="card-kicker"><%= t(".desk.audience_kicker") %></p>
                  <div class="channel">
                    <span class="channel-icon" aria-hidden="true">✦</span>
                    <p><%= t(".desk.channel_privacy") %><small><%= t(".desk.channel_privacy_who") %></small></p>
                    <span class="score">96</span>
                  </div>
                  <div class="channel">
                    <span class="channel-icon" aria-hidden="true">#</span>
                    <p><%= t(".desk.channel_meetup") %><small><%= t(".desk.channel_meetup_who") %></small></p>
                    <span class="score">82</span>
                  </div>
                  <div class="channel">
                    <span class="channel-icon" aria-hidden="true">@</span>
                    <p><%= t(".desk.channel_project") %><small><%= t(".desk.channel_project_who") %></small></p>
                    <span class="score low">14</span>
                  </div>
                </div>
              </div>
              <div class="routing-line" aria-hidden="true"></div>
              <div class="workspace-footer">
                <%= t(".desk.ready") %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="statement">
        <div class="shell">
          <div class="statement-grid">
            <div>
              <p class="eyebrow"><%= t(".statement.eyebrow") %></p>
              <h2><%= t(".statement.heading") %></h2>
            </div>
            <p class="statement-copy">
              <%= t(".statement.copy") %>
            </p>
          </div>
          <div class="answer-grid">
            <article class="answer">
              <span class="answer-number"><%= t(".statement.make.label") %></span>
              <h3><%= t(".statement.make.title") %></h3>
              <p>
                <%= t(".statement.make.copy") %>
              </p>
            </article>
            <article class="answer">
              <span class="answer-number"><%= t(".statement.speak.label") %></span>
              <h3><%= t(".statement.speak.title") %></h3>
              <p>
                <%= t(".statement.speak.copy") %>
              </p>
            </article>
            <article class="answer">
              <span class="answer-number"><%= t(".statement.remember.label") %></span>
              <h3><%= t(".statement.remember.title") %></h3>
              <p>
                <%= t(".statement.remember.copy") %>
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="how" id="how-it-works">
        <div class="shell">
          <div class="how-heading">
            <div>
              <p class="eyebrow"><%= t(".how.eyebrow") %></p>
              <h2><%= t(".how.heading") %></h2>
            </div>
            <p><%= t(".how.subheading") %></p>
          </div>
          <div class="steps">
            <article class="step">
              <span class="step-index">01</span>
              <h3><%= t(".how.gather.title") %></h3>
              <p>
                <%= t(".how.gather.copy") %>
              </p>
            </article>
            <article class="step">
              <span class="step-index">02</span>
              <h3><%= t(".how.name.title") %></h3>
              <p>
                <%= t(".how.name.copy") %>
              </p>
            </article>
            <article class="step">
              <span class="step-index">03</span>
              <h3><%= t(".how.share.title") %></h3>
              <p>
                <%= t(".how.share.copy") %>
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="closing">
        <div class="shell closing-grid">
          <div>
            <p class="eyebrow"><%= t(".closing.eyebrow") %></p>
            <h2><%= t(".closing.heading") %></h2>
          </div>
          <a class="button" href="<%= nostr_login_path %>"
            ><%= t(".closing.launch") %> <span class="arrow" aria-hidden="true">&#8599;</span></a
          >
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-inner">
        <p><%= t(".footer.tagline") %></p>
        <p><%= t(".footer.sign_in") %></p>
        <p>
          <a href="https://github.com/jooray/lievik" target="_blank" rel="noopener"
            ><%= t(".footer.github") %> &#8599;</a
          >
        </p>
      </div>
      <nav class="shell footer-lang-nav" aria-label="<%= t(".language_label") %>">
        <ul class="footer-langs">
          <% I18n.available_locales.each do |lang| %>
            <li>
              <a href="<%= localized_landing_path(locale: lang) %>" hreflang="<%= lang %>" lang="<%= lang %>"<% if lang == I18n.locale %> aria-current="page"<% end %>
                ><%= ApplicationHelper::LOCALE_NAMES.fetch(lang, lang.to_s) %></a
              >
            </li>
          <% end %>
        </ul>
      </nav>
    </footer>

    <script nonce="<%= content_security_policy_nonce %>">
      (function () {
        var root = document.documentElement;

        function prefersDark() {
          return window.matchMedia("(prefers-color-scheme: dark)").matches;
        }

        function readTheme() {
          try {
            return localStorage.getItem("theme") || "system";
          } catch (e) {
            return "system";
          }
        }

        function isDark() {
          var t = readTheme();
          return t === "dark" || (t === "system" && prefersDark());
        }

        function apply() {
          root.classList.toggle("dark", isDark());
        }

        apply();

        // Keep "system" mode in sync with the OS preference.
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", apply);

        // The landing toggle flips between explicit light/dark and writes to the
        // same "theme" key the app uses, so the choice carries into the app.
        // NOTE: `.theme-toggle` is shared with the GitHub link next to it, so
        // this must target the button by id.
        var themeSwitch = document.getElementById("theme-switch");
        if (themeSwitch) {
          themeSwitch.addEventListener("click", function () {
            var next = isDark() ? "light" : "dark";
            try {
              localStorage.setItem("theme", next);
            } catch (e) {}
            apply();
          });
        }

        // The language <details> works without JS; this just closes it on an
        // outside click or Escape like any other menu.
        var langMenu = document.getElementById("lang-menu");
        if (langMenu) {
          document.addEventListener("click", function (event) {
            if (langMenu.open && !langMenu.contains(event.target)) {
              langMenu.open = false;
            }
          });
          document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && langMenu.open) {
              langMenu.open = false;
              langMenu.querySelector("summary").focus();
            }
          });
        }
      })();
    </script>
  </body>
</html>
