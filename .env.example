# Required for AI features (VeniceAI - OpenAI compatible)
VENICE_API_KEY=your-venice-api-key

# Optional - separate key for the typed-decision rating engine (defaults to VENICE_API_KEY)
# DECISION_API_KEY=

# Optional - for alternative AI providers
OPENAI_API_KEY=sk-...
OLLAMA_HOST=http://localhost:11434

# Database (production only; app uses local MariaDB/MySQL via socket)
DATABASE_PASSWORD=example-mariadb-password

# Rails
SECRET_KEY_BASE=
RAILS_ENV=development

# Optional - paid access through nostr-billing (the hosted instance only).
# Leave unset when self-hosting: nothing is gated and the billing pages answer
# 404. http is accepted only for a loopback address.
# BILLING_API_URL=http://127.0.0.1:8340
# BILLING_API_TOKEN=

# Optional - Android app version gate, served by GET /api/v1/meta. An app below
# the minimum must update; below the latest it shows an update notice. The
# download link is also shown on /user/edit when set.
# ANDROID_MIN_VERSION_CODE=1
# ANDROID_LATEST_VERSION_CODE=1
# ANDROID_DOWNLOAD_URL=https://example.com/lievik.apk
