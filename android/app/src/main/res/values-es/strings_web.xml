    <string name="settings_system_prompt_label">Prompt de sistema (contexto para la IA)</string>
    <string name="settings_system_prompt_intro">Este prompt de sistema le da a la IA contexto sobre ti para valorar mejor la relevancia en todos los canales. El predeterminado funciona sin tocar nada, pero conseguirás mejores resultados si lo personalizas.</string>
    <string name="settings_system_prompt_make_it_yours">Hazlo tuyo: cuenta quién eres, a qué ámbitos y proyectos te dedicas (p. ej., «creador de herramientas de IA»), qué estilo prefieres (conciso, técnico, promocional), para quién escribes (desarrolladores, creadores) y con qué tono (profesional, inspirador). Así la IA entiende mejor tu situación.</string>
    <string name="settings_event_link_label">Plantilla de enlace a publicación</string>
    <string name="settings_event_link_hint">Plantilla de URL para enlazar publicaciones de Nostr (notas) en el contenido generado. Usa {eventid} donde deba ir el identificador nevent/note.</string>
    <string name="settings_naddr_link_label">Plantilla de enlace a artículo (naddr)</string>
    <string name="settings_naddr_link_hint">Plantilla de URL para enlazar artículos largos de Nostr (eventos reemplazables). Usa {naddr} donde deba ir el identificador naddr.</string>
    <string name="settings_profile_link_label">Plantilla de enlace a perfil</string>
    <string name="settings_profile_link_hint">Plantilla de URL para enlazar perfiles de Nostr. Usa {npub} donde deba ir el identificador npub.</string>
    <string name="settings_rating_engine_label">Motor de valoración</string>
    <string name="settings_rating_engine_hint">Qué IA valora la relevancia de cada publicación para cada canal. Los dos motores puntúan en la misma escala de 0 a 100, así que los umbrales de los canales siguen funcionando; las publicaciones ya valoradas conservan su puntuación hasta que se vuelvan a valorar.</string>
    <string name="settings_engine_chat_label">Modelo de chat</string>
    <string name="settings_engine_chat_badge">(predeterminado)</string>
    <string name="settings_engine_chat_hint">Una petición por cada canal y publicación. Escribe un breve motivo con cada puntuación. Es más lento y más caro, pero conoce el mundo (reconoce el hashtag de una conferencia, una persona o un proyecto).</string>
    <string name="settings_engine_decision_label">Modelo de decisión tipado</string>
    <string name="settings_engine_decision_badge">(beta)</string>
    <string name="settings_engine_decision_hint">Una petición por publicación para todos los canales a la vez. Unas diez veces más rápido, varias veces más barato y más consistente entre ejecuciones; devuelve probabilidades en lugar de un motivo escrito y no reconoce referencias que nunca ha visto. Funciona en el nivel anonymized (no private) de Venice.</string>
    <string name="settings_writing_style_label">Estilo de escritura predeterminado</string>
    <string name="settings_writing_style_hint">Estilo de escritura que se usa al crear canales nuevos. Puedes cambiarlo en los ajustes de cada canal.</string>
    <string name="settings_writing_style_placeholder">P. ej., profesional pero cercano, de tú al lector, sin jerga, párrafos cortos…</string>
