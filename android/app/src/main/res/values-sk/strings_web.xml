    <string name="settings_event_link_hint">Šablóna URL pre odkazy na Nostr príspevky (poznámky) v generovanom obsahu. Identifikátor nevent/note sa dosadí za {eventid}.</string>
    <string name="settings_naddr_link_label">Šablóna odkazu na článok (naddr)</string>
    <string name="settings_naddr_link_hint">Šablóna URL pre odkazy na dlhé Nostr články (nahraditeľné eventy). Identifikátor naddr sa dosadí za {naddr}.</string>
    <string name="settings_profile_link_label">Šablóna odkazu na profil</string>
    <string name="settings_profile_link_hint">Šablóna URL pre odkazy na Nostr profily. Identifikátor npub sa dosadí za {npub}.</string>
    <string name="settings_rating_engine_label">Hodnotiaci engine</string>
    <string name="settings_rating_engine_hint">Určuje, ktorá AI hodnotí, nakoľko je príspevok relevantný pre jednotlivé kanály. Oba enginy dávajú skóre na rovnakej škále 0–100, takže prahy kanálov platia ďalej. Už ohodnotené príspevky si staré skóre ponechajú, kým ich neohodnotíte znova.</string>
    <string name="settings_engine_chat_label">Chatový model</string>
    <string name="settings_engine_chat_badge">(predvolený)</string>
    <string name="settings_engine_chat_hint">Jedna požiadavka na každú dvojicu kanál a príspevok. Ku každému skóre napíše krátke zdôvodnenie. Je pomalší a drahší, no pozná svet (spozná hashtag konferencie, človeka či projekt).</string>
