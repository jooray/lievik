    <string name="settings_system_prompt_label">System Prompt (AI Context)</string>
    <string name="settings_system_prompt_intro">This system prompt gives AI context about you for better relevance across channels. Default works out-of-box, but customize for optimal results.</string>
    <string name="settings_system_prompt_make_it_yours">Make it yours: Describe who you are, domains/projects (e.g., \"AI tools builder\"), style (concise/tech/promotional), audience (developers/creators), tone (professional/inspirational). Helps AI grasp your unique situation.</string>
    <string name="settings_event_link_label">Event Link Template</string>
    <string name="settings_event_link_hint">URL template for linking to Nostr events (notes) in generated content. Use {eventid} as placeholder for the nevent/note identifier.</string>
    <string name="settings_naddr_link_label">Article Link Template (naddr)</string>
    <string name="settings_naddr_link_hint">URL template for linking to Nostr long-form articles (replaceable events). Use {naddr} as placeholder for the naddr identifier.</string>
    <string name="settings_profile_link_label">Profile Link Template</string>
    <string name="settings_profile_link_hint">URL template for linking to Nostr profiles. Use {npub} as placeholder for the npub identifier.</string>
    <string name="settings_rating_engine_label">Rating Engine</string>
    <string name="settings_rating_engine_hint">Which AI rates how relevant each event is for each channel. Scores from both engines are on the same 0-100 scale, so channel thresholds keep working; events already rated keep their old score until re-rated.</string>
    <string name="settings_engine_chat_label">Chat model</string>
    <string name="settings_engine_chat_badge">(default)</string>
    <string name="settings_engine_chat_hint">One request per channel and event. Writes a short reason with every score. Slower and costs more, but knows the world (recognises a conference hashtag, a person, a project).</string>
    <string name="settings_engine_decision_label">Typed decision model</string>
    <string name="settings_engine_decision_badge">(beta)</string>
    <string name="settings_engine_decision_hint">One request per event for all channels at once. About ten times faster, several times cheaper, and more consistent run to run; returns probabilities instead of a written reason and does not recognise references it has never seen. Runs on Venice\'s anonymized (not private) tier.</string>
    <string name="settings_writing_style_label">Default Writing Style</string>
    <string name="settings_writing_style_hint">Default writing style used when creating new channels. You can customize it per channel in the channel settings.</string>
    <string name="settings_writing_style_placeholder">E.g., Professional but approachable, use second person (\'you\'), avoid jargon, keep paragraphs short...</string>
